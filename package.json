{
  "name": "spsplast-ecommerce",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/export-snapshot.mjs && node scripts/validate-models-2027.mjs && next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.js",
    "models:build": "python3 scripts/extract/build_models_2027.py",
    "models:images": "python3 scripts/extract/build_images_2027.py",
    "models:check": "node scripts/validate-models-2027.mjs",
    "redirects:build": "python3 scripts/extract/build_redirects_2027.py",
    "fonts:sync": "node scripts/sync-fonts.js",
    "images:variants": "node scripts/extract/build_site_variants.mjs",
    "images:bg": "python3 scripts/extract/remove_bg_2027.py",
    "photos:import": "python3 scripts/extract/build_models_2027.py && python3 scripts/extract/remove_bg_2027.py --only media-src/live/ && python3 scripts/extract/build_images_2027.py && python3 scripts/extract/build_redirects_2027.py && node scripts/validate-models-2027.mjs",
    "catalog3d:build": "python3 scripts/extract/build_3d_catalog_2027.py",
    "3d:dark": "node scripts/3d/dark-viewer.mjs",
    "3d:tering": "node scripts/3d/build-tering.mjs",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "audit:seo": "node scripts/audit-seo-dom.mjs",
    "audit": "node scripts/audit-seo-dom.mjs && node scripts/audit-a11y.mjs",
    "shots": "node scripts/visual/compare-screens.mjs",
    "lighthouse": "node scripts/visual/lighthouse.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:migrate:deploy": "node scripts/db-migrate.mjs --deploy",
    "admin:create": "node --experimental-strip-types scripts/admin-create.ts",
    "snapshot": "node scripts/export-snapshot.mjs",
    "catalog:import": "node --experimental-strip-types scripts/catalog-import.ts",
    "catalog:sync-2026-11-16": "node --experimental-strip-types scripts/catalog-sync-2026-11-16.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.72.0",
    "next": "^16.4.6",
    "page-flip": "^2.0.7",
    "pdfjs-dist": "^4.10.38",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "three": "0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.25.12",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.29",
    "jsdom": "^31.0.1",
    "lighthouse": "^13.6.0",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}

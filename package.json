{
  "name": "spsplast-ecommerce",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-static-catalog.js --check && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.js",
    "catalog:build": "node scripts/build-static-catalog.js",
    "catalog:check": "node scripts/build-static-catalog.js --check",
    "models:build": "python3 scripts/extract/build_models_2027.py",
    "models:images": "python3 scripts/extract/build_images_2027.py",
    "models:check": "node scripts/validate-models-2027.mjs",
    "fonts:sync": "node scripts/sync-fonts.js",
    "media:build": "python3 scripts/build-media.py"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.428.0",
    "next": "^15.5.26",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.26",
    "postcss": "^8.4.41",
    "typescript": "^5.5.4"
  }
}

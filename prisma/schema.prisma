datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------
// ADMIN & AUTHENTICATION
// ------------------------------------------------------

model AdminUser {
  id           String         @id @default(uuid())
  email        String         @unique
  name         String
  passwordHash String
  role         String         @default("ADMIN")
  sessions     AdminSession[]
  auditLogs    AuditLog[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model AdminSession {
  id        String    @id @default(uuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())
}

model AuditLog {
  id           String     @id @default(uuid())
  adminId      String?
  admin        AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action       String // e.g. LOGIN, PRODUCT_CREATE, PRODUCT_UPDATE, ORDER_STATUS_CHANGE
  entityType   String // e.g. Product, Order, Category
  entityId     String?
  metadataJson String?
  createdAt    DateTime   @default(now())
}

// ------------------------------------------------------
// CATEGORIES & TRANSLATIONS
// ------------------------------------------------------

model Category {
  id           String                @id @default(uuid())
  parentId     String?
  parent       Category?             @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]            @relation("CategoryHierarchy")
  image        String?
  storageKey   String?
  sortOrder    Int                   @default(0)
  status       String                @default("ACTIVE") // ACTIVE, ARCHIVED
  translations CategoryTranslation[]
  attributes   CategoryAttribute[]
  products     ProductCategory[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model CategoryTranslation {
  id              String   @id @default(uuid())
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale          String // uz, ru, en
  name            String
  slug            String
  description     String?
  metaTitle       String?
  metaDescription String?

  @@unique([categoryId, locale])
  @@unique([locale, slug])
}

// ------------------------------------------------------
// DYNAMIC ATTRIBUTE SYSTEM
// ------------------------------------------------------

model AttributeDefinition {
  id           String                  @id @default(uuid())
  code         String                  @unique // e.g. thickness, cavities, material, color
  type         String                  @default("TEXT") // TEXT, NUMBER, BOOLEAN, SELECT, MULTISELECT
  unit         String? // e.g. mm, kg, quyish
  filterable   Boolean                 @default(true)
  searchable   Boolean                 @default(true)
  variantAxis  Boolean                 @default(false)
  sortOrder    Int                     @default(0)
  translations AttributeTranslation[]
  options      AttributeOption[]
  categories   CategoryAttribute[]
  values       ProductAttributeValue[]
}

model AttributeTranslation {
  id          String              @id @default(uuid())
  attributeId String
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  locale      String // uz, ru, en
  name        String // e.g. "Qalinligi", "Толщина"

  @@unique([attributeId, locale])
}

model AttributeOption {
  id            String                       @id @default(uuid())
  attributeId   String
  attribute     AttributeDefinition          @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  code          String // e.g. smooth, brick, travertin
  sortOrder     Int                          @default(0)
  translations  AttributeOptionTranslation[]
  productValues ProductAttributeValue[]
  variantValues ProductVariantOption[]

  @@unique([attributeId, code])
}

model AttributeOptionTranslation {
  id       String          @id @default(uuid())
  optionId String
  option   AttributeOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  locale   String // uz, ru, en
  label    String // e.g. "Silliq", "Гладкий"

  @@unique([optionId, locale])
}

model CategoryAttribute {
  id          String              @id @default(uuid())
  categoryId  String
  category    Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  required    Boolean             @default(false)
  sortOrder   Int                 @default(0)

  @@unique([categoryId, attributeId])
}

// ------------------------------------------------------
// PRODUCTS, VARIANTS, MEDIA & ATTRIBUTES
// ------------------------------------------------------

model Product {
  id             String  @id @default(uuid())
  sku            String  @unique
  status         String  @default("ACTIVE") // DRAFT, ACTIVE, ARCHIVED
  basePrice      Int // Base price in UZS (Integer to avoid float rounding)
  compareAtPrice Int? // Original price before discount
  currency       String  @default("UZS")
  inStock        Boolean @default(true)
  stockQty       Int     @default(100)
  trackInventory Boolean @default(true)
  allowBackorder Boolean @default(false)
  isBestseller   Boolean @default(false)
  isNew          Boolean @default(false)

  // Specific quick metrics for Mold/Construction
  yieldPerCast    Int? // e.g. 6 (Cavities)
  durabilityCasts Int? // e.g. 350 (Lifetime casts)
  videoUrl        String?

  translations    ProductTranslation[]
  categories      ProductCategory[]
  variants        ProductVariant[]
  attributeValues ProductAttributeValue[]
  media           ProductMedia[]
  orderItems      OrderItem[]
  leads           Lead[]

  publishedAt DateTime? @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ProductTranslation {
  id               String  @id @default(uuid())
  productId        String
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale           String // uz, ru, en
  name             String
  slug             String
  shortDescription String?
  description      String?
  metaTitle        String?
  metaDescription  String?

  @@unique([productId, locale])
  @@unique([locale, slug])
}

model ProductCategory {
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model ProductAttributeValue {
  id           String              @id @default(uuid())
  productId    String
  product      Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId  String
  attribute    AttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  textValue    String?
  numberValue  Float?
  booleanValue Boolean?
  optionId     String?
  option       AttributeOption?    @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([productId, attributeId, optionId])
}

model ProductVariant {
  id             String                 @id @default(uuid())
  productId      String
  product        Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String                 @unique
  price          Int // Variant price override in UZS
  compareAtPrice Int?
  stockQty       Int                    @default(10)
  status         String                 @default("ACTIVE")
  options        ProductVariantOption[]
  media          ProductMedia[]
  orderItems     OrderItem[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
}

model ProductVariantOption {
  id        String          @id @default(uuid())
  variantId String
  variant   ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionId  String
  option    AttributeOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([variantId, optionId])
}

model ProductMedia {
  id         String          @id @default(uuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  type       String          @default("GALLERY") // MAIN, GALLERY, DIMENSION, DETAIL, USAGE, MOLD, FINISHED_RESULT, VIDEO
  url        String
  storageKey String?
  mimeType   String?
  width      Int?
  height     Int?
  sizeBytes  Int?
  alt        String?
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
}

// ------------------------------------------------------
// ORDERS, ITEMS SNAPSHOT & ATTRIBUTION
// ------------------------------------------------------

model Order {
  id             String  @id @default(uuid())
  orderNumber    String  @unique
  idempotencyKey String? @unique
  customerName   String
  customerPhone  String
  region         String
  city           String?
  address        String
  deliveryType   String  @default("COURIER") // COURIER, PICKUP
  deliveryFee    Int     @default(0)
  paymentMethod  String  @default("CASH") // CASH, CLICK, PAYME, BANK_TRANSFER
  paymentStatus  String  @default("PENDING") // PENDING, PAID, FAILED, REFUNDED
  status         String  @default("NEW") // NEW, CONFIRMED, PROCESSING, READY, SHIPPED, DELIVERED, CANCELLED
  totalAmount    Int // Total in UZS
  notes          String?

  // Marketing & Attribution snapshot
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  utmContent  String?
  utmTerm     String?
  gclid       String?
  fbclid      String?
  referrer    String?
  landingPage String?

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([status])
  @@index([customerPhone])
  @@index([createdAt])
}

model OrderStatusHistory {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  adminId    String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model OrderItem {
  id          String          @id @default(uuid())
  orderId     String
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sku         String
  productName String
  variantName String?
  unitPrice   Int // Price per unit in UZS at time of purchase
  quantity    Int
  lineTotal   Int // quantity * unitPrice
}

// ------------------------------------------------------
// LEADS, WHOLESALE & CONTENT
// ------------------------------------------------------

model Lead {
  id        String   @id @default(uuid())
  name      String
  phone     String
  company   String?
  type      String   @default("B2B_WHOLESALE") // B2B_WHOLESALE, CONSULTATION
  message   String?
  quantity  Int?
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  status    String   @default("NEW")

  // Attribution
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  gclid       String?
  fbclid      String?

  createdAt DateTime @default(now())
}

model BlogPost {
  id           String                @id @default(uuid())
  author       String                @default("SPS Plast Mutaxassisi")
  coverImage   String
  isPublished  Boolean               @default(true)
  publishedAt  DateTime              @default(now())
  translations BlogPostTranslation[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

model BlogPostTranslation {
  id      String   @id @default(uuid())
  postId  String
  post    BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  locale  String // uz, ru, en
  slug    String
  title   String
  excerpt String?
  content String

  @@unique([postId, locale])
  @@unique([locale, slug])
}

model Project {
  id            String   @id @default(uuid())
  titleUz       String
  titleRu       String
  descriptionUz String
  descriptionRu String
  location      String
  productUsed   String
  beforeImage   String?
  afterImage    String
  createdAt     DateTime @default(now())
}

model Banner {
  id         String   @id @default(uuid())
  titleUz    String
  titleRu    String
  subTitleUz String?
  subTitleRu String?
  imageUrl   String
  storageKey String?
  linkUrl    String?
  position   String   @default("HERO")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  valueJson String
  updatedAt DateTime @updatedAt
}

# ======================================================
# SPS PLAST — MUHIT O'ZGARUVCHILARI
# ======================================================
#
# Sayt ma'lumotlarni statik katalogdan o'qiydi: `data/models-2027.json` va
# undan generatsiya qilinadigan `src/data/models2027.ts` (git'da saqlanadi).
# Baza faqat zayafkalar va admin panel uchun (Bosqich 7–8); Telegram bot
# zayafkani savdo bo'limi guruhiga yuboradi (HANDOFF 5).
# Analitika ID'lari bo'sh bo'lsa birorta tashqi skript yuklanmaydi.

# --- SAYT ---
# Canonical, sitemap va hreflang manzillari shu qiymatga tayanadi.
# Kanonik domen spsplast.com (eski sps.uz va www.* next.config.js da 301 qilinadi).
NEXT_PUBLIC_SITE_URL="https://spsplast.com"

# --- BAZA (ZAYAFKALAR + ADMIN PANEL) — PRODUCTIONDA MAJBURIY ---
# Neon / Supabase Postgres. Bo'lmasa zayafka faqat Telegram'ga ketadi (saqlanmaydi),
# /admin ishlamaydi. O'rnatish: docs/ADMIN.md (db:migrate + admin:create).
DATABASE_URL=""

# --- ADMIN → "NASHR QILISH" ---
# Admin'dagi mahsulot/integratsiya o'zgarishlarini saytga chiqarish (qayta build, docs/ADMIN.md).
# Coolify (Hetzner, hozirgi): resurs → Webhooks → "Deploy webhook" URL + Coolify API tokeni
# (Keys & Tokens, "deploy" huquqi). Vercel: VERCEL_DEPLOY_HOOK_URL (tokensiz).
# SNAPSHOT_REQUIRED=1 — baza javob bermasa build to'xtaydi.
DEPLOY_HOOK_URL=""
DEPLOY_HOOK_TOKEN=""
VERCEL_DEPLOY_HOOK_URL=""
SNAPSHOT_REQUIRED=""

# --- TELEGRAM (ZAYAFKALAR) — MAJBURIY ---
# @BotFather dan token, guruh ID si (@userinfobot orqali aniqlanadi).
# Ikkalasi bo'lmasa forma ishlaydi, lekin xabar hech qayerga bormaydi
# (/api/health "degraded" holatini ko'rsatadi).
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_CHAT_ID="-100123456789"

# --- ANALITIKA (ixtiyoriy, lekin tavsiya etiladi — P0-12) ---
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# O'zbekiston bozorida asosiy kanal:
NEXT_PUBLIC_YANDEX_METRICA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# --- XAVFSIZLIK (ixtiyoriy) ---
# IP manzilning rate-limit kalitidagi HMAC xeshi uchun (src/server/privacy.ts).
# Bo'sh bo'lsa boshqa server siridan (DATABASE_URL/TELEGRAM_BOT_TOKEN) foydalaniladi —
# ishlayveradi, lekin alohida kalit to'g'riroq.
IP_HASH_SECRET=""
# Sozlansa, /api/health batafsil javobni (Telegram/baza/analitika holati) faqat shu token
# bilan beradi (`?token=` yoki `Authorization: Bearer`) — aks holda faqat {status}. Admin →
# Sozlamalar sahifasidagi havola buni o'zi qo'shadi.
HEALTH_CHECK_TOKEN=""
# Admin "Nashr qilish" panelida oxirgi Vercel deploy holatini ko'rsatish uchun (ixtiyoriy):
# Account → Tokens; Project → Settings → General; jamoa loyihasida VERCEL_TEAM_ID ham kerak.
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""

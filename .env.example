# ======================================================
# SPS PLAST E-COMMERCE - ENVIRONMENT CONFIGURATION
# ======================================================

# --- DATABASE ---
DATABASE_URL="postgresql://user:password@localhost:5432/spsplast_db?schema=public&sslmode=prefer"
DIRECT_URL="postgresql://user:password@localhost:5432/spsplast_db?schema=public"

# --- AUTH & SECURITY ---
AUTH_SECRET="your_super_secret_jwt_or_session_key_min_32_chars"
SEED_ADMIN_EMAIL="admin@spsplast.uz"
SEED_ADMIN_PASSWORD="ChangeMeInProduction2026!"

# --- SITE CONFIG ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- TELEGRAM BOT INTEGRATION ---
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_CHAT_ID="-100123456789"

# --- MEDIA & S3 COMPATIBLE STORAGE (CLOUDFLARE R2 / AWS S3) ---
S3_ENDPOINT="https://account-id.r2.cloudflarestorage.com"
S3_BUCKET="spsplast-media"
S3_ACCESS_KEY="your_access_key"
S3_SECRET_KEY="your_secret_key"
S3_PUBLIC_URL="https://media.spsplast.uz"

# --- ANALYTICS & PIXELS ---
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_META_PIXEL_ID="1234567890"

# --- CRM INTEGRATION (AMOCRM / BITRIX24 WEBHOOKS) ---
AMOCRM_SUBDOMAIN=""
AMOCRM_CLIENT_ID=""
AMOCRM_CLIENT_SECRET=""
AMOCRM_REDIRECT_URI=""

# --- PAYMENT PROVIDERS (CLICK / PAYME) ---
CLICK_MERCHANT_ID=""
CLICK_SERVICE_ID=""
CLICK_SECRET_KEY=""

PAYME_MERCHANT_ID=""
PAYME_SECRET_KEY=""

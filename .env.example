# ======================================================
# SPS PLAST — MUHIT O'ZGARUVCHILARI
# ======================================================
#
# Sayt ma'lumotlarni statik katalogdan o'qiydi: `data/models-2027.json` va
# undan generatsiya qilinadigan `src/data/models2027.ts` (git'da saqlanadi).
# Baza faqat zayafkalar va admin panel uchun (Bosqich 7–8); Telegram bot
# zayafkani savdo bo'limi guruhiga yuboradi (HANDOFF 5).
# Analitika ID'lari bo'sh bo'lsa birorta tashqi skript yuklanmaydi.

# --- SAYT ---
# Canonical, sitemap va hreflang manzillari shu qiymatga tayanadi.
NEXT_PUBLIC_SITE_URL="https://sps.uz"

# --- BAZA (ZAYAFKALAR + ADMIN PANEL) — PRODUCTIONDA MAJBURIY ---
# Neon / Supabase Postgres. Bo'lmasa zayafka faqat Telegram'ga ketadi (saqlanmaydi),
# /admin ishlamaydi. O'rnatish: docs/ADMIN.md (db:migrate + admin:create).
DATABASE_URL=""

# --- ADMIN → "NASHR QILISH" ---
# Vercel → Settings → Git → Deploy Hooks. Admin'dagi mahsulot/integratsiya o'zgarishlarini
# saytga chiqarish uchun (docs/ADMIN.md). SNAPSHOT_REQUIRED=1 — baza javob bermasa build to'xtaydi.
VERCEL_DEPLOY_HOOK_URL=""
SNAPSHOT_REQUIRED=""

# --- TELEGRAM (ZAYAFKALAR) — MAJBURIY ---
# @BotFather dan token, guruh ID si (@userinfobot orqali aniqlanadi).
# Ikkalasi bo'lmasa forma ishlaydi, lekin xabar hech qayerga bormaydi
# (/api/health "degraded" holatini ko'rsatadi).
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
TELEGRAM_CHAT_ID="-100123456789"

# --- ANALITIKA (ixtiyoriy, lekin tavsiya etiladi — P0-12) ---
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# O'zbekiston bozorida asosiy kanal:
NEXT_PUBLIC_YANDEX_METRICA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
